":false,"feature_enabled":true},"impressionData":false},{"name":"page-level-analytics","enabled":true,"variant":{"name":"disabled","enabled":false,"feature_enabled":true},"impressionData":false},{"name":"editor-version-history-v2","enabled":true,"variant":{"name":"disabled","enabled":false,"feature_enabled":true},"impressionData":false},{"name":"billing-page-v2","enabled":true,"variant":{"name":"disabled","enabled":false,"feature_enabled":true},"impressionData":false},{"name":"full-page-search","enabled":true,"variant":{"name":"disabled","enabled":false,"feature_enabled":true},"impressionData":false},{"name":"workspace-projects","enabled":true,"variant":{"name":"disabled","enabled":false,"feature_enabled":true},"impressionData":false},{"name":"assistant-v5","enabled":true,"variant":{"name":"disabled","enabled":false,"feature_enabled":true},"impressionData":false},{"name":"fork-pr-previews","enabled":true,"variant":{"name":"disabled","enabled":false,"feature_enabled":true},"impressionData":false},{"name":"revalidation-jwt","enabled":true,"variant":{"name":"disabled","enabled":false,"feature_enabled":true},"impressionData":false},{"name":"workos-sso-scim","enabled":true,"variant":{"name":"disabled","enabled":false,"feature_enabled":true},"impressionData":false},{"name":"hobby-abuse-scan","enabled":true,"variant":{"name":"disabled","enabled":false,"feature_enabled":true},"impressionData":false},{"name":"dashboard-inbox","enabled":true,"variant":{"name":"disabled","enabled":false,"feature_enabled":true},"impressionData":false},{"name":"workos-signup","enabled":true,"variant":{"name":"disabled","enabled":false,"feature_enabled":true},"impressionData":false},{"name":"turbopuffer-dual-write","enabled":true,"variant":{"name":"disabled","enabled":false,"feature_enabled":true},"impressionData":false},{"name":"workos-enabled","enabled":true,"variant":{"name":"disabled","enabled":false,"feature_enabled":true},"impressionData":false},{"name":"approve-review-flow","enabled":true,"variant":{"name":"disabled","enabled":false,"feature_enabled":true},"impressionData":false},{"name":"editor-metadata","enabled":true,"variant":{"name":"disabled","enabled":false,"feature_enabled":true},"impressionData":false},{"name":"sso-setup-deadline-banner","enabled":true,"variant":{"name":"disabled","enabled":false,"feature_enabled":true},"impressionData":false},{"name":"turbopuffer-serve","enabled":true,"variant":{"name":"disabled","enabled":false,"feature_enabled":true},"impressionData":false},{"name":"live-agents","enabled":true,"variant":{"name":"disabled","enabled":false,"feature_enabled":true},"impressionData":false},{"name":"starter-pricing","enabled":true,"variant":{"name":"control","enabled":true,"payload":{"type":"string","value":"control"},"feature_enabled":true},"impressionData":false},{"name":"llms-txt-v2","enabled":true,"variant":{"name":"disabled","enabled":false,"feature_enabled":true},"impressionData":false},{"name":"wildcard-email-auth","enabled":true,"variant":{"name":"disabled","enabled":false,"feature_enabled":true},"impressionData":false}],"googleFontsInlined":false},"customCss":[{"filePath":"style.css","content":"#content-area{--font-mono: var(--font-jetbrains-mono), ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace;h5 {\n    font-weight: 500;\n  }\n\n  h6 {\n    font-weight: 400;\n  }\n\n  /* Fix code block line highlight color */\n  code .line-highlight {\n    --primary-light: 100 175 250;\n  }}#enable-section-numbers{display:none}body:has(#enable-section-numbers){#content-area,\n  #table-of-contents {\n    counter-reset: h2-counter h3-counter h4-counter h5-counter h6-counter;\n  }\n\n  #content-area h2[id],\n  #table-of-contents li[data-depth=\"0\"] {\n    counter-increment: h2-counter;\n    counter-set: h3-counter h4-counter h5-counter h6-counter;\n  }\n\n  #content-area h3[id],\n  #table-of-contents li[data-depth=\"1\"] {\n    counter-increment: h3-counter;\n    counter-set: h4-counter h5-counter h6-counter;\n  }\n\n  #content-area h4[id],\n  #table-of-contents li[data-depth=\"2\"] {\n    counter-increment: h4-counter;\n    counter-set: h5-counter h6-counter;\n  }\n\n  #content-area h5[id],\n  #content-area h5,\n  #table-of-contents li[data-depth=\"3\"] {\n    counter-increment: h5-counter;\n    counter-set: h6-counter;\n  }\n\n  #content-area h6[id],\n  #content-area h6,\n  #table-of-contents li[data-depth=\"4\"] {\n    counter-increment: h6-counter;\n  }\n\n  #table-of-contents li a::before {\n    flex-shrink: 0;\n  }\n\n  #content-area h2[id]::before,\n  #table-of-contents li[data-depth=\"0\"] a::before {\n    content: counter(h2-counter) \". \";\n  }\n\n  #content-area h3[id]::before,\n  #table-of-contents li[data-depth=\"1\"] a::before {\n    content: counter(h2-counter) \".\" counter(h3-counter) \" \";\n  }\n\n  #content-area h4[id]::before,\n  #table-of-contents li[data-depth=\"2\"] a::before {\n    content: counter(h2-counter) \".\" counter(h3-counter) \".\" counter(h4-counter)\n      \" \";\n  }\n\n  #content-area h5[id]::before,\n  #content-area h5::before,\n  #table-of-contents li[data-depth=\"3\"] a::before {\n    content: counter(h2-counter) \".\" counter(h3-counter) \".\" counter(h4-counter)\n      \".\" counter(h5-counter) \" \";\n  }\n\n  #content-area h6[id]::before,\n  #content-area h6::before,\n  #table-of-contents li[data-depth=\"4\"] a::before {\n    content: counter(h2-counter) \".\" counter(h3-counter) \".\" counter(h4-counter)\n      \".\" counter(h5-counter) \".\" counter(h6-counter) \" \";\n  }}#schema-reference{display:none}body:has(#schema-reference){* {\n    scroll-margin-top: 8rem;\n  }\n\n  --mt-sm: 0.25rem;--mt-md: 0.5rem;--mt-lg: 1rem;--mt-xl: 1.5rem;h2, h3 {\n    margin: 0;\n  }\n  .type + h2, .type h3 {\n    margin-top: calc(5 * var(--mt-lg));\n  }\n  h2 + .type h3 {\n    margin-top: var(--mt-xl);\n  }\n\n  /* Type definition code */\n  .tsd-signature {\n    margin: var(--mt-lg) 0 0 0;\n  }\n\n  /* Prose */\n  .tsd-comment {\n    margin: var(--mt-lg) 0 0 0;\n\n    p, ul, ol, li {\n      margin: 0;\n    }\n\n    * + :is(p, ul, ol, pre) {\n      margin-top: var(--mt-lg);\n    }\n\n    * + li {\n      margin-top: var(--mt-sm);\n    }\n  }\n\n  /* Example block (`@example` tag) */\n  .tsd-tag-example {\n    margin: var(--mt-lg) 0 0 0;\n\n    summary + * {\n      margin: var(--mt-sm) 0 0 0;\n      scroll-margin-top: calc(8rem + 1.5rem + var(--mt-sm));\n    }\n  }\n\n  /* \"See\" links (`@see` tag) */\n  .tsd-tag-see {\n    \u0026 > :is(p, ul) {\n      margin-top: 0;\n    }\n  }\n\n  /* Type member */\n  .tsd-member {\n    margin: var(--mt-lg) 0 0 0;\n\n    /* Description */\n    .tsd-comment {\n      margin-top: var(--mt-sm);\n    }\n\n    /* Sub-members */\n    .tsd-type-declaration {\n      /* List */\n      [data-typedoc-h=\"4\"] + .tsd-parameters {\n        margin: var(--mt-md) 0 0 0;\n      }\n    }\n\n    /* Example (`@example` tag) inside type member */\n    .tsd-tag-example {\n      margin: var(--mt-sm) 0 0 0;\n    }\n  }}body:has(#schema-reference){.tsd-comment {\n    a.tsd-kind-type-alias,\n    a.tsd-kind-interface,\n    a.tsd-kind-property {\n      font-family: var(--font-mono);\n      font-size: 0.875em;\n    }\n  }\n\n  /* Code blocks */\n  .tsd-signature,\n  .tsd-tag-example pre:has(code) {\n    /* Based on code blocks rendered by Mintlify. */\n    border: 1px solid;\n    border-color: light-dark(rgb(var(--gray-950)/.1), rgba(255 255 255/0.1));\n    border-radius: 1rem;\n    padding: 1rem 0.875rem;\n\n    background-color: inherit;\n    color: inherit;\n    font-family: var(--font-mono);\n    font-size: 0.875rem;\n    line-height: 1.5rem;\n  }\n\n  /* Type definition code */\n  .tsd-signature {\n    a {\n      font-weight: normal;\n      border-bottom: none;\n      text-decoration: underline;\n\n      \u0026:hover {\n        text-decoration-thickness: 2px;\n      }\n    }\n\n    a[href=\"#\"] {\n      pointer-events: none;\n      color: inherit;\n      text-decoration: none;\n    }\n\n    .tsd-signature-keyword {\n      color: light-dark(rgb(207, 34, 46), #9CDCFE);\n    }\n\n    :is(.tsd-kind-interface, .tsd-kind-type-alias):not(.tsd-signature-type) {\n      color: light-dark(rgb(149, 56, 0), #4EC9B0);\n    }\n\n    .tsd-signature-type:not(.tsd-kind-interface, .tsd-kind-type-alias) {\n      color: light-dark(rgb(5, 80, 174), #DCDCAA);\n    }\n  }\n\n  /* Example block (`@example` tag) */\n  .tsd-tag-example {\n    /* Label */\n    summary {\n      font-weight: 600;\n      font-style: italic;\n    }\n\n    /* Code */\n    pre code.json {\n      .hl-1 {\n        color: light-dark(rgb(17, 99, 41), #9CDCFE);\n      }\n      .hl-2, .hl-3 {\n        color: light-dark(rgb(10, 48, 105), #CE9178);\n      }\n      .hl-5 {\n        color: light-dark(rgb(5, 80, 174), #569CD6);\n      }\n    }\n\n    /* Copy button */\n    pre button {\n      display: none;\n    }\n  }\n\n  /* \"See\" links (`@see` tag) */\n  .tsd-tag-see {\n    /* Add trailing \":\" to heading */\n    [data-typedoc-h=\"4\"]::after {\n      content: \": \";\n    }\n\n    /* Hide (defunct) anchor link */\n    .tsd-anchor-icon {\n      display: none;\n    }\n\n    /* Case: single link -- display inline with heading */\n    \u0026:has(> p) {\n      [data-typedoc-h=\"4\"], p {\n        display: inline;\n      }\n    }\n  }\n\n  /* Type member */\n  .tsd-member {\n    /* Hide members that don't have doc comments */\n    \u0026:not(:has(.tsd-comment)) {\n      display: none;\n    }\n\n    /* When the type itself has a doc comment, add a subtle top border to the first visible member */\n    .tsd-comment ~ \u0026:has(.tsd-comment):not(.tsd-member:has(.tsd-comment) ~ *) {\n      border-top: 2px solid light-dark(rgb(var(--gray-950)/.05), rgba(255 255 255/0.1));\n      padding-top: var(--mt-md);\n    }\n\n    /* Member name */\n    [data-typedoc-h=\"3\"] {\n      font-family: var(--font-mono);\n      font-weight: 700;\n    }\n\n    \u0026 > .tsd-comment,\n    \u0026 > .tsd-type-declaration {\n      margin-left: 1.25rem;\n    }\n\n    /* Sub-members */\n    .tsd-type-declaration {\n      /* Templated heading (\"Type Declaration\") */\n      [data-typedoc-h=\"4\"] {\n        display: none;\n      }\n\n      /* Name and type */\n      [data-typedoc-h=\"5\"] {\n        font-family: var(--font-mono);\n        font-size: 0.875rem;\n        font-weight: 500;\n\n        width: fit-content;\n        padding: 0.125em 0.5em;\n        background-color: light-dark(rgb(var(--gray-100)/.5), rgb(255 255 255/.05));\n\n        .tsd-tag {\n          display: none;\n        }\n      }\n    }\n\n    /* Example (`@example` tag) inside type member */\n    .tsd-tag-example {\n      padding-left: 0.5rem;\n    }\n\n    .tsd-sources {\n      display: none;\n    }\n  }\n\n  /* Anchor links for members and examples */\n  .tsd-anchor-icon {\n    border: 0;\n    padding: 0 0.5rem;\n    color: rgb(var(--gray-500)/.5);\n\n    \u0026:hover {\n      color: rgb(var(--gray-500))\n    }\n\n    \u0026::before {\n      content: \"#\";\n      color: inherit;\n    }\n\n    svg {\n      display: none;\n    }\n  }\n\n  /* Types with only index properties (e.g., `type Foo = { [key: string]: unknown }`) */\n  .type > .tsd-type-declaration {\n    /* Hide property if no doc comments */\n    \u0026:not(:has(.tsd-comment)) {\n      display: none;\n    }\n\n    /* Templated heading (\"Type Declaration\") */\n    [data-typedoc-h=\"4\"] {\n      display: none;\n    }\n\n    /* Index property */\n    [data-typedoc-h=\"5\"] {\n      font-family: var(--font-mono);\n      font-weight: 700;\n    }\n  }}#footer{flex-wrap:wrap;row-gap:1.5rem}#lf-copyright{flex:1 1 32rem;min-width:0;text-align:center;font-size:0.875rem;color:rgb(var(--gray-500));line-height:1.5;a {\n    color: inherit;\n    text-decoration: underline;\n\n    \u0026:hover {\n      color: rgb(var(--gray-700));\n    }\n  }}"}]}</template>
    <template data-mint="manifest">{"page":{"pagePath":"specification/2026-07-28","slug":"/specification/2026-07-28","pageMetadata":{"title":"Specification","description":null,"href":"/specification/2026-07-28/index"},"pageType":"default","mdx":{"mdxSource":{"compiledSource":"\"use strict\";const{Fragment:_Fragment,jsx:_jsx,jsxs:_jsxs}=arguments[0];const{useMDXComponents:_provideComponents}=arguments[0];function _createMdxContent(props){const _components={a:`a`,code:`code`,li:`li`,ol:`ol`,p:`p`,strong:`strong`,ul:`ul`,..._provideComponents(),...props.components},{Card,CardGroup,Heading}=_components;if(!Card)_missingMdxReference(`Card`,true);if(!CardGroup)_missingMdxReference(`CardGroup`,true);if(!Heading)_missingMdxReference(`Heading`,true);return _jsxs(_Fragment,{children:[_jsx(`div`,{id:`enable-section-numbers`}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.a,{href:`https://modelcontextprotocol.io`,children:`Model Context Protocol`}),` (MCP) is an open protocol that\nenables seamless integration between LLM applications and external data sources and\ntools. Whether you’re building an AI-powered IDE, enhancing a chat interface, or creating\ncustom AI workflows, MCP provides a standardized way to connect LLMs with the context\nthey need.`]}),`\n`,_jsxs(_components.p,{children:[`This specification defines the authoritative protocol requirements, based on the\nTypeScript schema in\n`,_jsx(_components.a,{href:`https://github.com/modelcontextprotocol/specification/blob/main/schema/2026-07-28/schema.ts`,children:`schema.ts`}),`.`]}),`\n`,_jsxs(_components.p,{children:[`For implementation guides and examples, visit\n`,_jsx(_components.a,{href:`https://modelcontextprotocol.io`,children:`modelcontextprotocol.io`}),`.`]}),`\n`,_jsxs(_components.p,{children:[`The key words “MUST”, “MUST NOT”, “REQUIRED”, “SHALL”, “SHALL NOT”, “SHOULD”, “SHOULD\nNOT”, “RECOMMENDED”, “NOT RECOMMENDED”, “MAY”, and “OPTIONAL” in this document are to be\ninterpreted as described in `,_jsx(_components.a,{href:`https://datatracker.ietf.org/doc/html/bcp14`,children:`BCP 14`}),`\n[`,_jsx(_components.a,{href:`https://datatracker.ietf.org/doc/html/rfc2119`,children:`RFC2119`}),`]\n[`,_jsx(_components.a,{href:`https://datatracker.ietf.org/doc/html/rfc8174`,children:`RFC8174`}),`] when, and only when, they\nappear in all capitals, as shown here.`]}),`\n`,_jsx(Heading,{level:`2`,id:`overview`,children:`Overview`}),`\n`,_jsx(_components.p,{children:`MCP provides a standardized way for applications to:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`Share contextual information with language models`}),`\n`,_jsx(_components.li,{children:`Expose tools and capabilities to AI systems`}),`\n`,_jsx(_components.li,{children:`Build composable integrations and workflows`}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`The protocol uses `,_jsx(_components.a,{href:`https://www.jsonrpc.org/`,children:`JSON-RPC`}),` 2.0 messages to establish\ncommunication between:`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Hosts`}),`: LLM applications that initiate connections`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Clients`}),`: Connectors within the host application`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Servers`}),`: Services that provide context and capabilities`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`MCP takes some inspiration from the\n`,_jsx(_components.a,{href:`https://microsoft.github.io/language-server-protocol/`,children:`Language Server Protocol`}),`, which\nstandardizes how to add support for programming languages across a whole ecosystem of\ndevelopment tools. In a similar way, MCP standardizes how to integrate additional context\nand tools into the ecosystem of AI applications.`]}),`\n`,_jsx(Heading,{level:`2`,id:`key-details`,children:`Key Details`}),`\n`,_jsx(Heading,{level:`3`,id:`base-protocol`,children:`Base Protocol`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.a,{href:`https://www.jsonrpc.org/`,children:`JSON-RPC`}),` message format`]}),`\n`,_jsx(_components.li,{children:`Stateless, self-contained requests`}),`\n`,_jsx(_components.li,{children:`Per-request capability negotiation`}),`\n`]}),`\n`,_jsx(Heading,{level:`3`,id:`features`,children:`Features`}),`\n`,_jsx(_components.p,{children:`Servers offer any of the following features to clients:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Resources`}),`: Context and data, for the user or the AI model to use`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Prompts`}),`: Templated messages and workflows for users`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Tools`}),`: Functions for the AI model to execute`]}),`\n`]}),`\n`,_jsx(_components.p,{children:`Clients may offer the following features to servers:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Elicitation`}),`: Server requests for additional information from users`]}),`\n`]}),`\n`,_jsx(Heading,{level:`3`,id:`additional-utilities`,children:`Additional Utilities`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`Progress tracking`}),`\n`,_jsx(_components.li,{children:`Cancellation`}),`\n`,_jsx(_components.li,{children:`Subscriptions`}),`\n`,_jsx(_components.li,{children:`Completion`}),`\n`,_jsx(_components.li,{children:`Pagination`}),`\n`,_jsx(_components.li,{children:`Caching`}),`\n`,_jsx(_components.li,{children:`Error reporting`}),`\n`]}),`\n`,_jsx(Heading,{level:`3`,id:`extensions`,children:`Extensions`}),`\n`,_jsxs(_components.p,{children:[`Beyond the core protocol, MCP defines optional `,_jsx(_components.a,{href:`/extensions/overview`,children:`extensions`}),`\nthat add modular, specialized, or experimental functionality. Extensions\nare always opt-in and require explicit support from both client and server, `,_jsx(_components.a,{href:`/extensions/overview#negotiation`,children:`negotiated\nthrough capabilities`}),` that clients declare on each\nrequest and servers declare in their `,_jsx(_components.code,{children:`server/discover`}),` result.\nNotable extensions include:`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:_jsx(_components.a,{href:`/extensions/tasks/overview`,children:`Tasks`})}),`: Asynchronous execution of long-running\noperations, with polling, mid-flight input, and durable handles`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:_jsx(_components.a,{href:`/extensions/skills/overview`,children:`Skills over MCP`})}),`: Rich, structured\ninstructions for agent workflows, discovered and consumed through MCP`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:_jsx(_components.a,{href:`/extensions/apps/overview`,children:`MCP Apps`})}),`: Interactive UI elements (charts, forms,\nvideo players) rendered inline within conversations`]}),`\n`]}),`\n`,_jsx(Heading,{level:`2`,id:`security-and-trust-\u0026-safety`,children:`Security and Trust \u0026 Safety`}),`\n`,_jsx(_components.p,{children:`The Model Context Protocol enables powerful capabilities through arbitrary data access\nand code execution paths. With this power comes important security and trust\nconsiderations that all implementors must carefully address.`}),`\n`,_jsx(Heading,{level:`3`,id:`key-principles`,children:`Key Principles`}),`\n`,_jsxs(_components.ol,{children:[`\n`,_jsxs(_components.li,{children:[`\n`,_jsx(_components.p,{children:_jsx(_components.strong,{children:`User Consent and Control`})}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`Users must explicitly consent to and understand all data access and operations`}),`\n`,_jsx(_components.li,{children:`Users must retain control over what data is shared and what actions are taken`}),`\n`,_jsx(_components.li,{children:`Implementors should provide clear UIs for reviewing and authorizing activities`}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsx(_components.p,{children:_jsx(_components.strong,{children:`Data Privacy`})}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`Hosts must obtain explicit user consent before exposing user data to servers`}),`\n`,_jsx(_components.li,{children:`Hosts must not transmit resource data elsewhere without user consent`}),`\n`,_jsx(_components.li,{children:`User data should be protected with appropriate access controls`}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsx(_components.p,{children:_jsx(_components.strong,{children:`Tool Safety`})}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`Tools represent arbitrary code execution and must be treated with appropriate\ncaution.`,`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`In particular, descriptions of tool behavior such as annotations should be\nconsidered untrusted, unless obtained from a trusted server.`}),`\n`]}),`\n`]}),`\n`,_jsx(_components.li,{children:`Hosts must obtain explicit user consent before invoking any tool`}),`\n`,_jsx(_components.li,{children:`Users should understand what each tool does before authorizing its use`}),`\n`]}),`\n`]}),`\n`]}),`\n`,_jsx(Heading,{level:`3`,id:`implementation-guidelines`,children:`Implementation Guidelines`}),`\n`,_jsxs(_components.p,{children:[`While MCP itself cannot enforce these security principles at the protocol level,\nimplementors `,_jsx(_components.strong,{children:`SHOULD`}),`:`]}),`\n`,_jsxs(_components.ol,{children:[`\n`,_jsx(_components.li,{children:`Build robust consent and authorization flows into their applications`}),`\n`,_jsx(_components.li,{children:`Provide clear documentation of security implications`}),`\n`,_jsx(_components.li,{children:`Implement appropriate access controls and data protections`}),`\n`,_jsx(_components.li,{children:`Follow security best practices in their integrations`}),`\n`,_jsx(_components.li,{children:`Consider privacy implications in their feature designs`}),`\n`]}),`\n`,_jsx(Heading,{level:`2`,id:`learn-more`,children:`Learn More`}),`\n`,_jsx(_components.p,{children:`Explore the detailed specification for each protocol component:`}),`\n`,_jsxs(CardGroup,{cols:5,children:[_jsx(Card,{title:`Architecture`,icon:`sitemap`,href:`/specification/2026-07-28/architecture`}),_jsx(Card,{title:`Base Protocol`,icon:`code`,href:`/specification/2026-07-28/basic`}),_jsx(Card,{title:`Server Features`,icon:`server`,href:`/specification/2026-07-28/server`}),_jsx(Card,{title:`Client Features`,icon:`user`,href:`/specification/2026-07-28/client/elicitation`}),_jsx(Card,{title:`Contributing`,icon:`pencil`,href:`/community/contributing`})]})]})}function MDXContent(props={}){const{wrapper:MDXLayout}={..._provideComponents(),...props.components};return MDXLayout?_jsx(MDXLayout,{...props,children:_jsx(_createMdxContent,{...props})}):_createMdxContent(props)}return{default:MDXContent};function _missingMdxReference(id,component){throw new Error(`Expected `+(component?`component`:`object`)+\" `\"+id+\"` to be defined: you likely forgot to import, pass, or provide it.\")}","frontmatter":{},"scope":{"config":{},"pageMetadata":{"title":"Specification","description":null,"href":"/specification/2026-07-28/index"}}},"mdxSourceWithNoJs":null},"mdxExtracts":{"tableOfContents":[{"title":"Overview","slug":"overview","depth":2,"children":[]},{"title":"Key Details","slug":"key-details","depth":2,"children":[{"title":"Base Protocol","slug":"base-protocol","depth":3,"children":[]},{"title":"Features","slug":"features","depth":3,"children":[]},{"title":"Additional Utilities","slug":"additional-utilities","depth":3,"children":[]},{"title":"Extensions","slug":"extensions","de