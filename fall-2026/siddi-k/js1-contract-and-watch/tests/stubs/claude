#!/usr/bin/env python3
"""Stub `claude` for tests only (CONTRACT.md, Wrong versions). Never calls a model.

Reads the prompt from stdin as bytes, appends {argv, cwd, cwd_listing, stdin_hex} to $JS1_STUB_DIR/calls.jsonl, then
prints the next canned stdout from $JS1_STUB_DIR/responses.json (a JSON list of strings; the last one repeats).
A response of "<ECHO>" returns a valid envelope whose justification is the first 300 characters of the prompt.
"""
import json
import os
import sys

stub_dir = os.environ["JS1_STUB_DIR"]
data = sys.stdin.buffer.read()
log = os.path.join(stub_dir, "calls.jsonl")
n = sum(1 for _ in open(log, encoding="utf-8")) if os.path.exists(log) else 0
with open(log, "a", encoding="utf-8") as f:
    f.write(json.dumps({"argv": sys.argv[1:], "cwd": os.getcwd(), "cwd_listing": os.listdir("."),
                        "stdin_hex": data.hex()}) + "\n")
with open(os.path.join(stub_dir, "responses.json"), encoding="utf-8") as f:
    responses = json.load(f)
out = responses[min(n, len(responses) - 1)]
if out == "<ECHO>":
    answer = {"verdict": "relevant", "justification": data.decode("utf-8")[:300] or "empty",
              "cited_resume_fields": ["skills"], "cited_posting_fields": ["content"]}
    out = json.dumps({"type": "result", "is_error": False, "result": json.dumps(answer, ensure_ascii=False)},
                     ensure_ascii=False)
sys.stdout.buffer.write(out.encode("utf-8"))
