# Private data: never committed.
# Your real résumé, profile, tracker, contacts and transcripts live outside
# this repo. These lines are a second fence in case a copy lands here.
private/
*.private.*
*.real.*
transcripts/
*.docx
*.pdf
.env
.env.*
!.env.example

# Scratch output that is not run evidence
scratch/
tmp/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# OS, editors, local Claude Code settings
.DS_Store
.idea/
.vscode/
.claude/
