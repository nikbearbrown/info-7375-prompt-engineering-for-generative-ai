      "tool": "write_file",
      "input": "{\"content\":\"\\\"\\\"\\\"Compare version strings.\\\"\\\"\\\"\\n\\n\\ndef _parse(v):\\n    \\\"\\\"\\\"Split a version into (list of ints, pre-release tag or None).\\\"\\\"\\\"\\n    core, sep, pre = v.partition(\\\"-\\\")\\n    nums = [int(part) for part in core.split(\\\".\\\")]\\n    return nums, (pre if sep else None)\\n\\n\\ndef compare(a, b):\\n    \\\"\\\"\\\"Return -1, 0, or 1 as version a is older than, the same as, or newer than b.\\n\\n    A version is whole numbers separated by dots, like \\\"1.10.2\\\", optionally\\n    followed by \\\"-\\\" and a pre-release tag, like \\\"2.0.0-rc1\\\".\\n    - Numbers compare as numbers: \\\"1.10\\\" is newer than \\\"1.9\\\".\\n    - Missing numbers count as 0: \\\"1.0\\\" is the same as \\\"1.0.0\\\".\\n    - A pre-release is older than the same version without one:\\n      \\\"1.0.0-rc1\\\" is older than \\\"1.0.0\\\".\\n    - Two pre-releases of the same version compare by their tags as plain\\n      strings: \\\"1.0.0-alpha\\\" is older than \\\"1.0.0-beta\\\".\\n    \\\"\\\"\\\"\\n    na, pa = _parse(a)\\n    nb, pb = _parse(b)\\n\\n    width = max(len(na), len(nb))\\n    na = na + [0] * (width - len(na))\\n    nb = nb + [0] * (width - len(nb))\\n\\n    if na != nb:\\n        return -1 if na < nb else 1\\n\\n    if pa == pb:\\n        return 0\\n    # A release without a pre-release tag is newer than any pre-release.\\n    if pa is None:\\n        return 1\\n    if pb is None:\\n        return -1\\n    return -1 if pa < pb else 1\\n\",\"path\":\"/workspace/versions/compare.py\"}",
