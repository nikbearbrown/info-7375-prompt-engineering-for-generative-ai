      "tool": "write_file",
      "input": "{\"content\":\"\\\"\\\"\\\"Compare version strings.\\\"\\\"\\\"\\n\\n\\ndef _parse(version):\\n    \\\"\\\"\\\"Split a version into (list of ints with trailing zeros removed, pre-release tag or None).\\\"\\\"\\\"\\n    core, sep, pre = version.partition(\\\"-\\\")\\n    nums = [int(part) for part in core.split(\\\".\\\")]\\n    while nums and nums[-1] == 0:\\n        nums.pop()\\n    return nums, (pre if sep else None)\\n\\n\\ndef compare(a, b):\\n    \\\"\\\"\\\"Return -1, 0, or 1 as version a is older than, the same as, or newer than b.\\n\\n    A version is whole numbers separated by dots, like \\\"1.10.2\\\", optionally\\n    followed by \\\"-\\\" and a pre-release tag, like \\\"2.0.0-rc1\\\".\\n    - Numbers compare as numbers: \\\"1.10\\\" is newer than \\\"1.9\\\".\\n    - Missing numbers count as 0: \\\"1.0\\\" is the same as \\\"1.0.0\\\".\\n    - A pre-release is older than the same version without one:\\n      \\\"1.0.0-rc1\\\" is older than \\\"1.0.0\\\".\\n    - Two pre-releases of the same version compare by their tags as plain\\n      strings: \\\"1.0.0-alpha\\\" is older than \\\"1.0.0-beta\\\".\\n    \\\"\\\"\\\"\\n    na, pa = _parse(a)\\n    nb, pb = _parse(b)\\n\\n    # Compare numeric parts, padding the shorter one with zeros.\\n    length = max(len(na), len(nb))\\n    na_padded = na + [0] * (length - len(na))\\n    nb_padded = nb + [0] * (length - len(nb))\\n    if na_padded != nb_padded:\\n        return -1 if na_padded < nb_padded else 1\\n\\n    # Same numbers: a pre-release is older than a release.\\n    if pa is None and pb is None:\\n        return 0\\n    if pa is None:\\n        return 1\\n    if pb is None:\\n        return -1\\n\\n    # Two pre-releases compare by their tags as strings.\\n    if pa == pb:\\n        return 0\\n    return -1 if pa < pb else 1\\n\",\"path\":\"versions/compare.py\"}",
