+++ b/signup/validate.py
@@ -0,0 +1,19 @@
+"""Email address checks shared by sign-ups and invitations."""
+
+
+class SignupError(ValueError):
+    """Raised for an address that cannot be used."""
+
+
+def validate_email(email):
+    """Return email trimmed and lower-cased, or raise SignupError if it is not
+    a valid address: exactly one "@", a non-empty part before it, no spaces,
+    and a domain after it that contains a "." which is not its first or last
+    character."""
+    email = email.strip().lower()
+    if email.count("@") != 1 or " " in email:
+        raise SignupError(f"invalid address: {email!r}")
+    local, domain = email.split("@")
+    if not local or "." not in domain or domain.startswith(".") or domain.endswith("."):
+        raise SignupError(f"invalid address: {email!r}")
+    return email
