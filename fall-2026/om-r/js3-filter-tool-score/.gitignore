__pycache__/
*.pyc
.*.tmp
# local run state is regenerated by every run (JS2 convention)
state/
# Raw board responses (~15 MB per run) are regenerated by every run and are not
# committed (JS1/JS2 convention) - with ONE deliberate exception: the run behind
# the 1,332-posting filter run (logs/filter_run_20261121T132140Z.json). The reject
# audit and shortlist need that exact posting text to be checkable; a future live
# fetch would drift (JS2 README, board drift).
evidence/*
!evidence/*_20261121T132140Z.json
!evidence/*_20261121T132140Z_p[0-9].json
