# Caches and local secrets never leave this machine.
__pycache__/
*.pyc
.DS_Store
.env
*.key
# Anything personal (a real résumé, transcripts, an application tracker) stays outside the repo.
private/
# Raw responses are ~10 MB; the repo keeps the byte-identical .gz (check with: python3 -m jobwatch verify runs/<run>).
**/runs/*/raw_response.json
