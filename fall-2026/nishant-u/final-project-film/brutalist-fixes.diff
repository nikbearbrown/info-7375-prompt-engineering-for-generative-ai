+def ffmpeg_filter_path(path):
+    # a raw Windows path breaks a filtergraph: '\' is an escape and the drive
+    # colon splits options. Forward slashes + quoted, escaped colon parse on
+    # every OS ('C:\x\y.ttf' -> 'C\:/x/y.ttf').
+    return "'" + str(path).replace("\\", "/").replace(":", "\\:") + "'"
+
