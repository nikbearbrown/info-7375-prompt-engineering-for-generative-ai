    {
      "beat_id": "B05",
      "act": "INSIGHT",
      "narration_text": "Here's where people get tripped up. If an AI gives you a wrong answer, and you fix the seed, you don't get a better answer — you get that exact same wrong answer, perfectly, every time. Reproducing a mistake with total consistency doesn't fix the mistake. It just makes it very, very repeatable.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "reveal",
        "show": [
          {
            "at": "start",
            "event": "The phrase repeatable does not mean true appears."
