    {
      "beat_id": "B01",
      "act": "FRAME",
      "narration_text": "Here's the short version: a seed doesn't decide whether an answer is true. All it decides is whether a random process can be repeated — so you can run it again and inspect exactly the same thing. Repeatable is not the same as true, and that distinction is the whole point of this video.",
      "lead_silence_s": 0.8,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "type-on",
        "show": [
          {
            "at": "start",
            "event": "The writer types the first framing."
          },
          {
            "at": "middle",
            "event": "The mistaken framing is replaced with the repeatable-process claim."
          }
        ],
        "remotion": {
          "pattern": "BrutalistHesitantWriter",
          "props": {
            "text": "A seed makes the answer true.\nNo — it makes the run repeatable.",
            "triggerWords": "the answer true",
            "replacementWords": "the run repeatable",
            "face": "serif",
            "fontSize": 116,
            "seed": "claude-hai-seed-repeatable",
            "ink": "#3D3929",
