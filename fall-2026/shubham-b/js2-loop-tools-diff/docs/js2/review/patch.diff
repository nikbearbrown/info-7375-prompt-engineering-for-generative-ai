+NOTE_BELOW_FLOOR: Final = "below_floor"
+
+
+class FlooredProvider:
+    """GATE A2: a parsed board listing 1 to ``floor - 1`` postings is invalid.
+
+    Only the first parse is floored: in a JS1 run that is the live response
+    (``pipeline`` parses it before anything else); later parses re-read saved raws
+    for pending retries (A26) and keep their JS1 behaviour.
+
+    Args:
+        inner: The board's real provider.
+        floor: The planned ``min_postings``.
+    """
+
+    def __init__(self, inner: BoardProvider, floor: int) -> None:
+        self._inner = inner
+        self._floor = floor
+        self._parsed = False
+        self.below_floor = False
+
+    @property
+    def name(self) -> str:
+        """The inner provider's name."""
+        return self._inner.name
+
+    def jobs_url(self, board_token: str) -> str:
+        """The inner provider's URL."""
+        return self._inner.jobs_url(board_token)
+
+    def parse(self, body: bytes) -> ParsedBoard:
+        """Parses with the inner provider, then applies the floor once.
+
+        Raises:
+            InvalidResponse: The inner provider's, or ``below_floor``.
+        """
+        board = self._inner.parse(body)
+        first, self._parsed = not self._parsed, True
+        if first and not board.is_empty and board.fetched_count < self._floor:
+            self.below_floor = True
+            raise InvalidResponse(
+                NOTE_BELOW_FLOOR, f"{board.fetched_count} < {self._floor}"
+            )
+        return board
+
+
 class _Loop:
