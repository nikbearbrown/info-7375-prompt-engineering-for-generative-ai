    {
      "beat_id": "B03",
      "act": "WHY-SCALE",
      "narration_text": "Here's why anyone should care. Every year WebAIM tests the top one million home pages. In twenty twenty-six, ninety-five point nine percent had failures a machine can detect. About fifty-six errors per page. And it got worse, not better.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
